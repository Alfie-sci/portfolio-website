---
// index.astro Frontmatter
import { Image } from 'astro:assets';

import photo1 from '../assets/gallery/photo1.jpeg';
import photo2 from '../assets/gallery/photo2.jpeg';
import photo3 from '../assets/gallery/photo3.jpeg';
import photo4 from '../assets/gallery/photo4.jpeg';
import photo5 from '../assets/gallery/photo5.jpeg';
import photo6 from '../assets/gallery/photo6.jpeg';
import photo7 from '../assets/gallery/photo7.jpeg';
import photo8 from '../assets/gallery/photo8.jpeg';
import photo9 from '../assets/gallery/photo9.jpeg';

const contactSheetPhotos = [
	{ ref: "ENGINEERING_TWO.JPG", spec: "26mm // ISO 400 // f/1.8", asset: photo1 },
	{ ref: "AUTO_TRAIN.JPG", spec: "26mm // ISO 400 // f/1.8", asset: photo2 },
	{ ref: "GLASSON_DOCK_9.JPG", spec: "26mm // ISO 40 // f/1.6", asset: photo3 },
	{ ref: "EVENING_STAR_92220.JPG", spec: "26mm // ISO 160 // f/1.8", asset: photo4 },
	{ ref: "TURBINE_01.JPG", spec: "26mm // ISO 50 // f/1.6", asset: photo5 },
	{ ref: "COLOUR_SIGNALS_08.JPG", spec: "26mm // ISO 100 // f/1.6", asset: photo6 },
	{ ref: "PICADILLY_67.JPG", spec: "52mm // ISO 400 // f/1.6", asset: photo7 },
	{ ref: "TRAFFIC_LIGHT.JPG", spec: "26mm // ISO 32 // f/1.6", asset: photo8 },
	{ ref: "LANE_3.JPG", spec: "26mm // ISO 125 // f/1.6", asset: photo9 },

];

// Generate a timestamp at build time
const now = new Date();
const buildDate = now.toISOString().split('T')[0];
const buildTime = now.toTimeString().split(' ')[0].slice(0, 5);
const dynamicTimestamp = `[TIMESTAMP: ${buildDate} // ${buildTime}]`;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Alfie Ralls // PORTFOLIO_v2.0</title>
	<link rel="icon" type="image/png" href="/favicon.png" />
	<link rel="apple-touch-icon" href="/favicon.png" />
	<style>
		@import url('https://fonts.googleapis.com/css2?family=Doto:wght@300;400;500;700&display=swap');
		* { box-sizing: border-box; border-radius: 0 !important; }

		:root {
			/* BASE BLUEPRINT PALETTE */
			--blue-light: #0033cc;
			--blue-dark:  #e0eaf5;
			--blueprint-blue: light-dark(var(--blue-light), var(--blue-dark));
			--hover-bg: light-dark(var(--hover-bg-light), var(--hover-bg-dark));

			/* DRAFTING PEN ACCENT COLORS */
			--orange-light: #e65c00;
			--orange-dark:  #ff9933;
			--accent-orange: light-dark(var(--orange-light), var(--orange-dark));

			--green-light: #00802b;
			--green-dark:  #4dff88;
			--accent-green: light-dark(var(--green-light), var(--green-dark));

			--purple-light: #6600cc;
			--purple-dark:  #b366ff;
			--accent-purple: light-dark(var(--purple-light), var(--purple-dark));

			/* LIGHT MODE PALETTE */
			--bg-light: #ffffff;
			--text-light: #111111;
			--grid-light: #e0e6ed;
			--card-bg-light: #ffffff;
			--hover-bg-light: #ffedd5;
			--link-light: #0033cc;
			--markup-light: #d93025;

			/* DARK MODE PALETTE */
			--bg-dark: #0a1428;
			--text-dark: #e0eaf5;
			--grid-dark: #1c2e4a;
			--card-bg-dark: #112240;
			--hover-bg-dark: #4a2c11;
			--link-dark: #50c8ff;
			--markup-dark: #ff8a80;

			/* DYNAMIC VARIABLES */
			--bg-color: light-dark(var(--bg-light), var(--bg-dark));
			--text-color: light-dark(var(--text-light), var(--text-dark));
			--grid-color: light-dark(var(--grid-light), var(--grid-dark));
			--card-bg: light-dark(var(--card-bg-light), var(--card-bg-dark));
			--link-colour: light-dark(var(--link-light), var(--link-dark));
			--markup-color: light-dark(var(--markup-light), var(--markup-dark));

			/* HARDWARE SPECIFIC */
			--radar-green: #00cd00;
		}

		html {
			color-scheme: light dark;
		}

		body {
			background-color: var(--bg-color);
			background-image:
				linear-gradient(var(--grid-color) 1px, transparent 1px),
				linear-gradient(90deg, var(--grid-color) 1px, transparent 1px),
				linear-gradient(light-dark(rgba(0, 51, 204, 0.15), rgba(51, 102, 255, 0.15)) 2px, transparent 2px),
				linear-gradient(90deg, light-dark(rgba(0, 51, 204, 0.15), rgba(51, 102, 255, 0.15)) 2px, transparent 2px);
			background-size: 20px 20px, 20px 20px, 100px 100px, 100px 100px;
			background-position: -1px -1px, -1px -1px, -2px -2px, -2px -2px;
			color: var(--text-color);
			font-family: "Georgia", "Times New Roman", serif;
			line-height: 1.6;
			margin: 0;
			padding: 2rem 1rem;
		}

		.spec-container {
			max-width: 850px;
			margin: 0 auto;
			background: var(--bg-color);
			border: 2px solid var(--blueprint-blue);
			padding: 2rem;
			box-shadow: 8px 8px 0 var(--blueprint-blue);
			position: relative;
		}

		/* --- Fiduciary Crosshairs --- */
		.crosshair {
			position: absolute;
			width: 20px;
			height: 20px;
			pointer-events: none;
			z-index: 50;
		}
		.crosshair::before, .crosshair::after {
			content: "";
			position: absolute;
			background: var(--blueprint-blue);
		}
		.crosshair::before { top: 9px; left: 0; width: 20px; height: 1px; }
		.crosshair::after { top: 0; left: 9px; width: 1px; height: 20px; }

		.ch-tl { top: 10px; left: 10px; }
		.ch-tr { top: 10px; right: 10px; }
		.ch-bl { bottom: 10px; left: 10px; }
		.ch-br { bottom: 10px; right: 10px; }

		/* --- Typography --- */
		h1, h2, h3 {
			font-family: monospace;
			color: var(--blueprint-blue);
			margin-top: 0;
			margin-bottom: 0.5rem;
		}

		h1 {
			font-size: clamp(1.2rem, 5vw, 2rem) !important;
			overflow-wrap: break-word;
			word-break: break-word;
		}

		h2 {
			display: inline-block;
			background-color: var(--blueprint-blue);
			color: var(--bg-color) !important;
			padding: 0.2rem 0.8rem;
		}

		.mono {
			font-family: monospace;
			font-size: 0.9rem;
		}

		/* --- Structural Components --- */
		header {
			border-bottom: 1px solid var(--blueprint-blue);
			padding-bottom: 1rem;
			margin-bottom: 2rem;
		}

		nav {
			font-family: monospace;
			margin: 1.5rem 0 0 0;
			padding: 0;
			border-top: none;
			font-size: 0.9rem;
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem 1rem;
		}

		nav a {
			text-decoration: none;
			font-weight: bold;
			color: var(--blueprint-blue);
			padding: 0.1rem 0.2rem;
			position: relative;
			transition: background-color 0.2s ease, color 0.2s ease;
			line-height: 1.2;
		}

		nav a::before, nav a::after {
			color: light-dark(rgba(0, 51, 204, 0.3), rgba(51, 102, 255, 0.3));
			transition: all 0.2s ease;
		}
		nav a::before { content: "[ "; margin-right: 0.1rem; }
		nav a::after { content: " ]"; margin-left: 0.1rem; }

		nav a:hover, nav a:focus-visible {
			background: light-dark(rgba(230, 92, 0, 0.08), rgba(255, 153, 51, 0.12));
			color: var(--accent-orange);
			outline: none;
		}

		nav a:hover::before, nav a:hover::after,
		nav a:focus-visible::before, nav a:focus-visible::after {
			color: var(--accent-orange);
		}
		nav a:hover::before { margin-right: 0px; }
		nav a:hover::after { margin-left: 0px; }

		section {
			margin-bottom: 2rem;
			scroll-margin-top: 2rem;
			position: relative;
			overflow: hidden;

			padding: 10px;
			margin-top: -10px;
			margin-left: -10px;
			margin-right: -10px;
		}
		section::after {
			position: absolute;
			top: -30px;
			right: -10px;
			font-family: monospace;
			font-size: 15rem;
			font-weight: bold;
			color: var(--blueprint-blue);
			opacity: 0.04;
			line-height: 1;
			pointer-events: none;
			z-index: 0;
			padding: 0.8rem 0.8rem;
		}
		#manifest::after { content: "01"; }
		#projects::after { content: "02"; }
		#exhibit::after { content: "03"; }
		#status-board::after { content: "04"; }
		#transmission::after { content: "05"; }
		#network::after { content: "06"; }
		#handshake::after { content: "07"; }

		fieldset {
			border: 1px solid var(--blueprint-blue);
			padding: 0.9rem 1.5rem 1.5rem 1.5rem;
			margin-bottom: 2rem;
		}

		fieldset > legend + * {
			margin-top: 0;
		}

		legend {
			font-family: monospace;
			color: var(--blueprint-blue);
			font-weight: bold;
			padding: 0 0.5rem;
		}

		/* --- Interactive Links --- */
		a {
			color: var(--link-colour);
			text-decoration: underline;
			transition: all 0.2s ease;
		}

		a:visited {
			color: light-dark(#551a8b, #b085db);
		}

		a:hover {
			background: var(--hover-bg);
			color: var(--text-color);
			text-decoration: none;
			border-radius: 2px;
		}

		a:active {
			background: var(--markup-color);
			color: #ffffff;
		}

		/* --- SECTION: Geolocation Radar --- */
		.coord-trigger {
			position: relative;
			display: inline-block;
			padding: 0 4px;
			cursor: crosshair;
			transition: background 0.2s ease-out, color 0.2s ease-out;
		}

		.coord-trigger::before {
			content: "";
			position: absolute;
			top: 30px;
			left: 50%;
			width: 200px;
			height: 200px;
			background-color: #050505;
			border: 3px solid #1a1a1a;
			box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.8);
			border-radius: 8px;
			background-image:
				linear-gradient(rgba(0, 255, 65, 0.15) 1px, transparent 1px),
				linear-gradient(90deg, rgba(0, 255, 65, 0.15) 1px, transparent 1px);
			background-size: 20px 20px;
			background-position: center;
			transform: translateX(-50%) scale(0.95);
			transform-origin: top center;
			opacity: 0;
			pointer-events: none;
			z-index: 90;
			transition: opacity 0.2s ease-out, transform 0.2s ease-out;
		}

		.coord-trigger::after {
			content: "";
			position: absolute;
			top: 40px;
			left: 50%;
			width: 180px;
			height: 180px;
			border-radius: 50%;
			border: 1px solid rgba(0, 255, 65, 0.3);
			background-image: conic-gradient(
				from 0deg at 50% 50%,
				transparent 0deg,
				rgba(0, 255, 65, 0.1) 60deg,
				rgba(0, 255, 65, 0.8) 90deg,
				transparent 90deg
			);
			transform-origin: 50% 50%;
			transform: translateX(-50%) rotate(0deg);
			opacity: 0;
			pointer-events: none;
			z-index: 100;
			transition: opacity 0.2s ease-out;
		}

		.blip {
			position: absolute;
			width: 6px;
			height: 6px;
			background-color: var(--radar-green);
			border-radius: 50%;
			box-shadow: 0 0 8px var(--radar-green);
			opacity: 0;
			pointer-events: none;
			z-index: 110;
		}

		.blip-1 { top: 100px; left: calc(50% + 52px); }
		.blip-2 { top: 195px; left: calc(50% + 24px); }
		.blip-3 { top: 122px; left: calc(50% - 49px); }

		.coord-trigger:hover {
			background-color: light-dark(rgba(0, 51, 204, 0.05), rgba(51, 102, 255, 0.15));
		}

		.coord-trigger:active {
			background-color: rgba(0, 255, 65, 0.15);
			color: var(--radar-green);
		}

		.coord-trigger:active::before { opacity: 1; transform: translateX(-50%) scale(1); }
		.coord-trigger:active::after { opacity: 1; animation: tactical-radar-sweep 1.5s linear infinite; }
		.coord-trigger:active .blip { animation: blip-flash 1.5s infinite; }
		.coord-trigger:active .blip-1 { animation-delay: 1.37s; }
		.coord-trigger:active .blip-2 { animation-delay: 0.29s; }
		.coord-trigger:active .blip-3 { animation-delay: 0.79s; }

		@keyframes tactical-radar-sweep { to { transform: translateX(-50%) rotate(360deg); } }
		@keyframes blip-flash {
			0%, 100% { opacity: 0; transform: scale(0.5); }
			1%  { opacity: 1; transform: scale(1.5); }
			25% { opacity: 0.4; transform: scale(1); }
			50% { opacity: 0; }
		}

		/* --- Photography Matrix --- */
		.photo-grid-wrapper {
			position: relative;
			padding: 1.5rem;
			border: 1px dashed light-dark(rgba(0, 51, 204, 0.3), rgba(51, 102, 255, 0.3));
			margin-top: 2rem;
		}

		.crop-mark {
			position: absolute;
			width: 15px;
			height: 15px;
			border-color: var(--blueprint-blue);
			border-style: solid;
			border-width: 0;
		}
		.cm-tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
		.cm-tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
		.cm-bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
		.cm-br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

		.photo-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 1.5rem;
		}

		.photo-card {
			background: var(--bg-color);
			border: 1px solid var(--blueprint-blue);
			padding: 0.75rem 0.75rem 0 0.75rem;
			display: flex;
			flex-direction: column;
			box-shadow: 4px 4px 0 var(--blueprint-blue);
			transition: transform 0.2s ease-out, box-shadow 0.2s ease-out, border-color 0.2s ease-out;
			position: relative;
		}

		.photo-card::before {
			content: "";
			position: absolute;
			top: -12px;
			left: -16px;
			width: 45px;
			height: 25px;
			transform: rotate(-35deg);
			background-color: light-dark(rgba(0, 0, 0, 0.08), rgba(255, 255, 255, 0.2));
			backdrop-filter: blur(4px);
			border: 1px solid light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.1));
			z-index: 20;
		}

		.photo-card::after {
			content: "";
			position: absolute;
			top: 1px;
			left: 1px;
			width: calc(100% - 2px);
			height: calc(100% - 2px);
			background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.3) 50%, transparent 65%);
			background-size: 300% 100%;
			background-position: 100% 0;
			z-index: 5;
			pointer-events: none;
			transition: background-position 0.2s ease-in;
		}

		.photo-card:hover::after { background-position: 0 0; transition: background-position 0.2s ease-out; }

		.photo-card:hover {
			transform: translateY(-2px) rotate(-0.2deg) translateZ(0);
			box-shadow: 6px 6px 0 var(--accent-orange);
			border-color: var(--accent-orange);
			z-index: 10;
		}

		.photo-img {
			width: 100% !important;
			height: auto !important;
			aspect-ratio: 1 / 1 !important;
			object-fit: cover !important;
			display: block;
			filter: grayscale(10%) contrast(110%);
		}

		.photo-meta {
			padding: 1rem 0.25rem 0.75rem 0.25rem;
			font-family: monospace;
			font-size: 0.75rem;
			text-align: center;
			background: transparent;
			border-top: none;
			margin-top: auto;
			position: relative;
			z-index: 10;
			line-height: 1.3;
		}

		/* --- Title Block Footer --- */
		.title-block {
			display: grid;
			grid-template-columns: 2fr 2fr 1fr 2fr 1fr;
			border: 2px solid var(--blueprint-blue);
			margin-top: 4rem;
			font-size: 0.85rem;
		}
		.tb-section {
			padding: 0.75rem;
			border-right: 2px solid var(--blueprint-blue);
		}
		.tb-section:last-child { border-right: none; }

		/* --- Terminal-Grade Accessibility --- */
		*:focus { outline: none; }
		:focus-visible {
			outline: 2px dashed var(--markup-color) !important;
			outline-offset: 4px !important;
			background-color: light-dark(rgba(217, 48, 37, 0.05), rgba(255, 138, 128, 0.15)) !important;
		}
		.photo-card:focus-visible {
			box-shadow: 8px 8px 0 var(--markup-color);
			transform: translateY(-2px);
		}

		/* --- Project Dossiers --- */
		.project-dossier-list {
			display: flex;
			flex-direction: column;
			gap: 2rem;
			margin-bottom: 2rem;
		}

		.project-module {
			background: var(--card-bg);
			border: 2px solid var(--blueprint-blue);
			box-shadow: 6px 6px 0 var(--blueprint-blue);
			transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		}

		.project-module:hover {
			transform: translate(-2px, -2px);
			box-shadow: 8px 8px 0 var(--accent-orange);
			border-color: var(--accent-orange);
		}

		.module-header {
			border-bottom: 2px dashed var(--blueprint-blue);
			padding: 1rem 1.5rem 0.25rem 1.5rem;
			background: light-dark(rgba(0, 51, 204, 0.03), rgba(51, 102, 255, 0.05));
			transition: border-color 0.2s ease;
		}

		.project-module:hover .module-header {
			border-bottom-color: var(--accent-orange);
		}

		.module-title-row {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.5rem;
			flex-wrap: wrap;
			gap: 1rem;
		}

		.module-title-row h3 {
			margin: 0;
			font-size: 1.25rem;
		}

		.module-tech {
			font-size: 0.8rem;
			color: light-dark(#555, #aaa);
			letter-spacing: 1px;
		}

		.module-body { padding: 0 1.5rem 1.5rem 1.5rem; }
		.module-body p:first-child { margin-top: -1.3rem !important; padding-top: 0; }
		.module-body p { margin-top: 0; margin-bottom: 1.25rem; }
		.module-body p:last-child { margin-bottom: 0; }

		.status-indicator {
			font-weight: bold;
			font-family: "Courier New", Courier, monospace;
		}

		.date-box {
			display: inline-block;
			border: 1px solid var(--accent-green);
			background: light-dark(rgba(0, 128, 43, 0.05), rgba(77, 255, 136, 0.1));
			padding: 0.25rem 0.6rem;
			font-size: 0.8rem;
			color: var(--accent-green);
			white-space: nowrap;
		}

		.btn-deploy {
			display: inline-block;
			margin-top: 0.5rem;
			padding: 0.4rem 0.8rem;
			border: 1px dashed var(--blueprint-blue);
			background: var(--card-bg);
			color: var(--accent-orange);
			text-decoration: none;
			font-family: monospace;
			font-weight: bold;
			font-size: 0.85rem;
			transition: all 0.2s ease;
			text-transform: uppercase;
		}

		.btn-deploy:hover {
			background: var(--accent-orange);
			color: var(--bg-color);
			border-style: solid;
			border-color: var(--accent-orange);
		}

		.btn-deploy::before {
			content: "> LAUNCH: ";
			opacity: 0.7;
		}

		/* --- CIS Departure Board System --- */
		.cis-board {
			background-color: #050505;
			border: 4px solid #1a1a1a;
			padding: 1rem;
			color: #ffaa00;
			font-family: 'Doto', monospace;
			font-variation-settings: "ROND" 100;
			font-weight: 500;
			letter-spacing: 0.05em;
			margin-bottom: 2rem;
			overflow: hidden;
		}
		.cis-on-time { color: #00ff00; text-shadow: 0 0 5px rgba(0, 255, 0, 0.4); }
		.cis-row {
			display: flex;
			justify-content: flex-start;
			font-size: clamp(1.1rem, 1vw, 1.3rem);
			text-shadow: 0 0 1px rgba(255, 170, 0, 0.5);
			margin-bottom: 0;
		}
		.cis-colon {
			color: transparent;
			text-shadow: none;
			position: relative;
			display: inline-block;
			width: 0.5em;
		}
		.cis-colon::after {
			content: ""; position: absolute; left: 40%; top: 35%;
			transform: translateX(-50%); width: 2px; height: 2px;
			background-color: #ffaa00; box-shadow: 0 8px 0 #ffaa00;
		}
		.cis-rank { width: 50px; }
		.cis-time { width: 70px; }
		.cis-plat { width: 50px; text-align: center; }
		.cis-dest { flex-grow: 1; padding-left: 1rem; }
		.cis-status { width: 90px; text-align: right; }
		.cis-scroll-row {
			display: flex; font-size: 1.15rem; margin-bottom: 0; padding-bottom: 0;
			border-bottom: none; background-image: linear-gradient(to right, #cc8800 1px, transparent 1px);
			background-size: 2px 1px; background-position: bottom left; background-repeat: repeat-x;
		}
		.cis-board > div:last-child { border-bottom: none; background-image: none; margin-bottom: 0; padding-bottom: 0; }
		.cis-calling-label { white-space: nowrap; margin-right: 1rem; color: #cc8800; }
		.cis-scroll-container { flex-grow: 1; overflow: hidden; position: relative; container-type: inline-size; }
		.cis-scroll-text {
			display: inline-block; white-space: nowrap; animation: cis-scroll linear infinite;
			will-change: transform; transform: translateZ(0); backface-visibility: hidden;
		}
		@keyframes cis-scroll { 0% { transform: translate3d(100cqi, 0, 0); } 100% { transform: translate3d(-100%, 0, 0); } }
		.cis-blink { animation: cis-blinker 2s step-start infinite; }
		@keyframes cis-blinker { 50% { opacity: 0; } }

		/* --- Web Ring / External Links --- */
		.web-ring-list { list-style: none; padding: 0; margin: 0; }
		.web-ring-list li { margin-bottom: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
		.web-ring-list li:last-child { margin-bottom: 0; }
		.web-ring-desc { color: var(--text-color); }

		/* --- TX Array Interactivity --- */
		.tx-mast { cursor: crosshair; transition: color 0.3s ease, text-shadow 0.3s ease; }
		.tx-mast:hover { color: var(--radar-green) !important; text-shadow: 0 0 8px rgba(0, 255, 65, 0.4); }
		.tx-waves { display: inline-block; transition: opacity 0.3s ease; }
		.tx-mast:hover .tx-waves { animation: rf-radiate 0.8s ease-in-out infinite alternate; }
		@keyframes rf-radiate {
			0% { opacity: 0.2; transform: scale(0.95); text-shadow: none; }
			100% { opacity: 1; transform: scale(1.05); text-shadow: 0 0 10px var(--radar-green); }
		}
		.tx-element { transition: color 0.2s ease; }
		.tx-mast:hover .tx-element-1 { color: #ffffff; transition-delay: 0.1s; }
		.tx-mast:hover .tx-element-2 { color: #ffffff; transition-delay: 0.2s; }
		.tx-wave-left {
			position: absolute; color: var(--radar-green); font-weight: bold; letter-spacing: 2px;
			pointer-events: none; opacity: 0; text-shadow: 0 0 5px var(--radar-green); z-index: -1;
		}
		.tx-mast:hover .tx-wave-left { animation: tx-propagate 2s linear infinite; }
		.tx-mast:hover .w2 { animation-delay: 1s; }
		@keyframes tx-propagate { 0% { transform: translateX(10px); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateX(-180px); opacity: 0; } }
		.tx-data-grid { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 0.5rem 1.5rem; line-height: 1.6; font-size: 0.9rem; }

		/* --- System Capabilities (Skills) --- */
		.skills-table { display: grid; grid-template-columns: 150px 1fr; gap: 1rem; line-height: 1.6; align-items: start; }
		.skill-label { color: var(--blueprint-blue); font-weight: bold; text-align: right; }
		.skill-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: flex-start; }
		.skill-chip {
			border: 1px dotted var(--blueprint-blue);
			background: light-dark(rgba(0, 51, 204, 0.04), rgba(51, 102, 255, 0.08));
			padding: 0 0.5rem;
			font-size: 0.85rem;
			color: var(--text-color);
			transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
		}

		.skill-chip:hover {
			background: var(--accent-orange);
			color: var(--bg-color);
			border-color: var(--accent-orange);
			border-style: solid;
			cursor: crosshair;
		}

		.endpoints-list { line-height: 1.8; overflow-wrap: break-word; word-break: break-all; }

		/* --- Media Queries & Print --- */
		@media print {
			body { background-color: #ffffff !important; color: #000000 !important; background-image: linear-gradient(#eaeaea 1px, transparent 1px), linear-gradient(90deg, #eaeaea 1px, transparent 1px) !important; }
			.spec-container { border: 1px solid #000000 !important; box-shadow: none !important; padding: 0 !important; max-width: 100% !important; }
			h1, h2, h3, a, legend { color: #000000 !important; text-decoration: none !important; }
			.coord-trigger::before, .coord-trigger::after, .photo-card::before, .photo-card::after { display: none !important; }
			.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr) !important; gap: 1rem !important; }
			.photo-card { break-inside: avoid; page-break-inside: avoid; border: 1px solid #000000 !important; box-shadow: none !important; transform: none !important; }
			.photo-img { filter: grayscale(100%) contrast(120%) !important; }
		}
		@media (max-width: 768px) {
			body { padding: 1rem 0.5rem; }
			.spec-container { padding: 1.5rem 1rem; box-shadow: 4px 4px 0 var(--blueprint-blue); }
			fieldset { padding: 1rem; }
			.title-block { grid-template-columns: 1fr; }
			.tb-section { border-right: none; border-bottom: 2px solid var(--blueprint-blue); padding: 1rem; }
			.tb-section:last-child { border-bottom: none; }
			.photo-grid-wrapper { padding: 1rem; }
			.tx-data-grid { grid-template-columns: auto 1fr; }
		}
		@media (max-width: 600px) {
			body { font-size: 0.95rem; line-height: 1.5; }
			h1 { font-size: 1.3rem !important; }
			h2 { font-size: 1.2rem; }
			nav { font-size: 0.85rem; }
			.mono { font-size: 0.8rem; }
			.ch-tl { top: 5px; left: 5px; } .ch-tr { top: 5px; right: 5px; } .ch-bl { bottom: 5px; left: 5px; } .ch-br { bottom: 5px; right: 5px; }
			.cis-board { padding: 0.5rem; } .cis-time { width: 40px; } .cis-plat { width: 20px; } .cis-status { width: 60px; } .cis-rank { width: 30px; }
			.cis-dest { padding-left: 0.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.cis-row { font-size: 0.75rem; } .cis-scroll-row { font-size: 0.8rem; } .cis-calling-label { margin-right: 0.5rem; }
			.tx-mast { font-size: 0.65rem !important; right: 0.5rem !important; }
			.photo-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; }
			.skills-table { grid-template-columns: 1fr; gap: 0.25rem; }
			.skill-label { text-align: left; margin-top: 0.75rem; }
		}
	</style>
</head>
