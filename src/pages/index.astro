			<div class="cis-row">
				<span class="cis-rank">1st</span>
				<span class="cis-time">11:16</span>
				<span class="cis-plat">4</span>
				<span class="cis-dest">BSc Computer Science</span>
				<span class="cis-status cis-blink cis-on-time">On time</span>
			</div>
			<div class="cis-scroll-row">
				<span class="cis-calling-label">Calling at</span>
				<div class="cis-scroll-container">
