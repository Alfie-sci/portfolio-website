import photo3 from '../assets/gallery/photo3.jpeg';
import photo4 from '../assets/gallery/photo4.jpeg';
import photo5 from '../assets/gallery/photo5.jpeg';
import photo6 from '../assets/gallery/photo6.jpeg';

// Create a highly structured data array with unique specs for each photo
const contactSheetPhotos = [
	{ ref: "ENGINEERING_ONE.JPG", spec: "26mm | ISO 400 | f/1.8", asset: photo1 },
	{ ref: "AUTO_TRAIN.JPG", spec: "26mm | ISO 400 | f/1.8", asset: photo2 },
	{ ref: "GLASSON_DOCK_9.JPG", spec: "26mm | ISO 40 | f/1.6", asset: photo3 },
	{ ref: "EVENING_STAR_92220.JPG", spec: "26mm | ISO 400 | f/1.8", asset: photo4 },
	{ ref: "TURBINE_01.JPG", spec: "26mm // ISO 50 // f/1.6", asset: photo5 },
	{ ref: "COLOUR_SIGNALS_08.JPG", spec: "26mm // ISO 100 // f/1.6", asset: photo6 },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Alfie Ralls // PORTFOLIO_v2.0</title>
	<style>
		/* Global Reset & Strict Structural Constraints */
		* { box-sizing: border-box; border-radius: 0 !important; }

		:root {
			/* Define the Light and Dark versions of your accent blue */
			--blue-light: #0033cc;
			--blue-dark:  #3366ff;

			/* Let the system choose which one to use */
			--blueprint-blue: light-dark(var(--blue-light), var(--blue-dark));

			/* LIGHT MODE PALETTE */
			--bg-light: #ffffff;
			--text-light: #111111;
			--grid-light: #e0e6ed;
			--card-bg-light: #fafafa;

			/* DARK MODE PALETTE (Stark Terminal Graphite) */
			--bg-dark: #050505;
			--text-dark: #f0f0f0;
			--grid-dark: #2d2d2d;
			--card-bg-dark: #111111;

			/* The System Switchers */
			--bg-color: light-dark(var(--bg-light), var(--bg-dark));
			--text-color: light-dark(var(--text-light), var(--text-dark));
			--grid-color: light-dark(var(--grid-light), var(--grid-dark));
			--card-bg: light-dark(var(--card-bg-light), var(--card-bg-dark));
		}

		/* Explicitly tell the browser that this website supports both modes */
		html {
			color-scheme: light dark;
		}

		body {
			background-color: var(--bg-color);
			background-image: linear-gradient(var(--grid-color) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
			background-size: 20px 20px;
			color: var(--text-color);
			font-family: "Georgia", "Times New Roman", serif;
			line-height: 1.6;
			margin: 0;
			padding: 2rem 1rem;
		}

		.spec-container {
			max-width: 850px;
			margin: 0 auto;
			background: var(--bg-color);
			border: 2px solid var(--blueprint-blue);
			padding: 2rem;
			box-shadow: 8px 8px 0 var(--blueprint-blue);
		}

		/* --- Typography --- */
		h1, h2, h3 {
			font-family: monospace;
			color: var(--blueprint-blue);
			margin-top: 0;
		}

		h1 {
			font-size: clamp(1.2rem, 5vw, 2rem) !important;
			overflow-wrap: break-word;
			word-break: break-word;
		}

		.mono {
			font-family: monospace;
			font-size: 0.9rem;
		}

		/* --- Structural Components --- */
		header {
			border-bottom: 1px dashed var(--blueprint-blue);
			padding-bottom: 0.1rem;
			margin-bottom: 2rem;
		}

		nav {
			font-family: monospace;
			margin: 1rem 0 0 0;
			padding: 0.5rem 0;
			border-top: 1px dashed var(--blueprint-blue);
		}

		nav a {
			margin-right: 1rem;
			text-decoration: none;
			font-weight: bold;
		}

		section {
			margin-bottom: 3.5rem;
			scroll-margin-top: 2rem;
		}

		fieldset {
			border: 1px solid var(--blueprint-blue);
			padding: 0.9rem 1.5rem 1.5rem 1.5rem;
			margin-bottom: 2rem;
		}

		fieldset > legend + * {
			margin-top: 0;
		}

		legend {
			font-family: monospace;
			color: var(--blueprint-blue);
			font-weight: bold;
			padding: 0 0.5rem;
		}

		/* --- Data Tables --- */
		table {
			width: 100%;
			border-collapse: collapse;
			font-family: monospace;
			margin-top: 1rem;
			display: block;
			overflow-x: auto;
			white-space: nowrap;
		}

		th, td {
			border: 1px solid var(--blueprint-blue);
			padding: 0.75rem;
			text-align: left;
		}

		th {
			background: var(--bg-color);
		}

		/* --- Interactive Links --- */
		a {
			color: var(--blueprint-blue);
			text-decoration: underline;
		}

		a:visited {
			color: light-dark(#551a8b, #b085db);
		}

		a:hover {
			background: var(--blueprint-blue);
			color: #ffffff;
			text-decoration: none;
		}

		a:active {
			background: #ff5500;
			color: #ffffff;
		}

		/* --- Photography Matrix (Polaroids) --- */
		.photo-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 1.5rem;
			margin-top: 2rem;
		}

		.photo-card {
			background: var(--bg-color);
			border: 1px solid var(--blueprint-blue);
			padding: 0.75rem 0.75rem 0 0.75rem;
			display: flex;
			flex-direction: column;
			box-shadow: 4px 4px 0 var(--blueprint-blue);
			transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;

			position: relative;
			/* THE FIX: We deleted 'overflow: hidden;' so the tape can break out! */
		}

		/* --- 1. The Corner Drafting Tape --- */
		.photo-card::before {
			content: "";
			position: absolute;
			/* Negative values physically pull the tape outside the boundaries of the card */
			top: -12px;
			left: -16px;
			width: 45px;
			height: 25px;

			/* Sharp corner angle */
			transform: rotate(-35deg);

			/* Frosted masking tape chemistry */
			background-color: light-dark(rgba(0, 0, 0, 0.08), rgba(255, 255, 255, 0.2));
			backdrop-filter: blur(4px);
			border: 1px solid light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.1));

			z-index: 20;
			transition: transform 0.2s ease-out;
		}

		/* The Tape Tension (Hover) */
		.photo-card:hover::before {
			/* Simulates physical tension. As the card lifts, the tape stretches and twists slightly */
			transform: translateY(2px) rotate(-32deg) scaleX(1.05);
		}

		/* The Upgraded Glossy Shine --- */
		/* Because we removed overflow: hidden, we must use a background-gradient sweep
		   instead of a physically moving element, otherwise the light spills everywhere! */
		.photo-card::after {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;

			/* The gradient is now mathematically angled, no skew transform required */
			background: linear-gradient(
				105deg,
				transparent 35%,
				rgba(255, 255, 255, 0.3) 50%,
				transparent 65%
			);

			/* We make the gradient 3x wider than the card */
			background-size: 300% 100%;
			/* Anchors the invisible part of the gradient over the card */
			background-position: 100% 0;

			z-index: 5;
			pointer-events: none;
			transition: background-position 0.2s ease-in; /* Fast snap back */
		}

		.photo-card:hover::after {
			/* Sweeps the gradient across the card to the other invisible side */
			background-position: 0 0;
			transition: background-position 0.2s ease-out;
		}

		/* The Hover States (Consolidated) */
		.photo-card:hover {
			transform: translateY(-5px) rotate(-0.5deg);
			box-shadow: 10px 10px 0 var(--blueprint-blue);
			z-index: 10;
		}

		.photo-img {
			width: 100% !important;
			height: auto !important;
			aspect-ratio: 1 / 1 !important;
			object-fit: cover !important;
			display: block;
			border: 1px solid var(--blueprint-blue);
			filter: grayscale(10%) contrast(110%);
		}

		.photo-meta {
			padding: 1rem 0.25rem 0.75rem 0.25rem;
			font-family: monospace;
			font-size: 0.75rem;
			text-align: center;
			background: transparent;
			border-top: none;
			margin-top: auto;
			position: relative;
			z-index: 10;
		}

		/* --- UK CIS Departure Board System --- */
		.cis-board {
			background-color: #050505;
			border: 4px solid #1a1a1a;
			padding: 1rem;
			color: #ffaa00;
			font-family: "Courier New", Courier, monospace;
			text-transform: uppercase;
			margin-bottom: 2rem;
			overflow: hidden;
		}

		.cis-on-time {
			color: #00ff00;
			text-shadow: 0 0 5px rgba(0, 255, 0, 0.4);
		}

		.cis-row {
			display: flex;
			justify-content: flex-start;
			font-size: clamp(0.9rem, 2vw, 1.1rem);
			font-weight: bold;
			margin-bottom: 0.25rem;
		}

		.cis-rank { width: 50px; }
		.cis-time { width: 70px; }
		.cis-plat { width: 50px; text-align: center; }
		.cis-dest { flex-grow: 1; padding-left: 1rem; }
		.cis-status { width: 90px; text-align: right; }

		.cis-scroll-row {
			display: flex;
			font-size: 0.85rem;
			margin-bottom: 1.5rem;
			padding-bottom: 1rem;
			border-bottom: 1px dotted #333;
		}

		.cis-board > div:last-child {
			border-bottom: none;
			margin-bottom: 0;
			padding-bottom: 0;
		}

		.cis-calling-label {
			white-space: nowrap;
			margin-right: 1rem;
			color: #cc8800;
		}

		.cis-scroll-container {
			flex-grow: 1;
			overflow: hidden;
			position: relative;
		}

		.cis-scroll-text {
			display: inline-block;
			white-space: nowrap;
			animation: cis-scroll 30s linear infinite;
			will-change: transform;
			transform: translateZ(0);
			backface-visibility: hidden;
		}

		@keyframes cis-scroll {
			0% { transform: translate3d(100%, 0, 0); }
			100% { transform: translate3d(-100%, 0, 0); }
		}

		.cis-blink {
			animation: cis-blinker 2s step-start infinite;
		}

		@keyframes cis-blinker {
			50% { opacity: 0; }
		}

		/* --- Media Queries (Mobile Optimization) --- */
		@media (max-width: 768px) {
			body {
				padding: 1rem 0.5rem;
			}
			.spec-container {
				padding: 1.25rem;
				box-shadow: 4px 4px 0 var(--blueprint-blue);
			}
			fieldset {
				padding: 1rem;
			}
			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			nav a {
				margin-right: 0.5rem;
			}
		}

		@media (max-width: 600px) {
			.cis-time { width: 55px; }
			.cis-plat { width: 30px; }
			.cis-status { width: 75px; }
			.cis-dest { padding-left: 0.5rem; }
		}
	</style>
</head>
<body>

