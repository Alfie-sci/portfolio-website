			<div class="crop-mark cm-br"></div>

			<div class="photo-grid">
				{contactSheetPhotos.map((photo, index) => (
					<div class="photo-card">
						<Image
							src={photo.asset}
							alt={`Photo log frame: ${photo.ref}`}
							class="photo-img"
							width={600}
							quality={90}
							loading={index < 2 ? "eager" : "lazy"}
						/>

						<div class="photo-meta">
							<strong>[{String(index + 1).padStart(2, '0')}A] {photo.ref}</strong><br />
							<span style="color: var(--blueprint-blue);">{photo.spec}</span>
