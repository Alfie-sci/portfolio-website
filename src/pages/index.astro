			</details>
			<!-- Row 4: Raspberry Pi -->
			<details class="hex-row">
				<summary class="hex-summary">
					<span class="hex-addr">0x0030</span>
					<span class="hex-bytes">52 61 73 70 62 65 72 72</span>
					<span class="hex-ascii">Raspberry Pi</span>
					<span class="hex-status status-offline">[OFFLINE]</span>
				</summary>
				<div class="project-details">
					<strong>[ADDR_SECTOR_0x0010: RASPBERRY_PI_SYS]</strong><br>
