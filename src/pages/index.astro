---
// index.astro Frontmatter
import { Image } from 'astro:assets';

// Import your images from src/assets/gallery/
import photo3 from '../assets/gallery/photo3.jpeg';
import photo4 from '../assets/gallery/photo4.jpeg';
import photo5 from '../assets/gallery/photo5.jpeg';
import photo6 from '../assets/gallery/photo6.jpeg';

// Create a highly structured data array with unique specs for each photo
const contactSheetPhotos = [
	{ ref: "TURBINE_01.JPG", spec: "26mm // ISO 50 // f/1.6", asset: photo5 },
	{ ref: "COLOUR_LIGHT_SIGNALS_08.JPG", spec: "26mm // ISO 100 // f/1.6", asset: photo6 },
	{ ref: "EVENING_STAR.JPG", spec: "26mm | ISO 400 | f/1.8", asset: photo4 },
	{ ref: "GLASSON_DOCK.JPG", spec: "26mm | ISO 40 | f/1.6", asset: photo3 },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Alfie Ralls // PORTFOLIO_v2.0</title>
	<style>
		/* Global Reset & Strict Structural Constraints */
		* { box-sizing: border-box; border-radius: 0 !important; }

		:root {
			/* 1. Define the Light and Dark versions of your accent blue */
			--blue-light: #0033cc;
			--blue-dark:  #3366ff; /* A brighter, more luminous blueprint/electric blue */

			/* 2. Let the system choose which one to use */
			--blueprint-blue: light-dark(var(--blue-light), var(--blue-dark));

			/* LIGHT MODE PALETTE */
			--bg-light: #ffffff;
			--text-light: #111111;
			--grid-light: #e0e6ed;
			--card-bg-light: #fafafa;

			/* DARK MODE PALETTE (Stark Terminal Graphite) */
			--bg-dark: #050505;
			--text-dark: #f0f0f0;
			--grid-dark: #2d2d2d;
			--card-bg-dark: #111111;

			/* The System Switchers */
			--bg-color: light-dark(var(--bg-light), var(--bg-dark));
			--text-color: light-dark(var(--text-light), var(--text-dark));
			--grid-color: light-dark(var(--grid-light), var(--grid-dark));
			--card-bg: light-dark(var(--card-bg-light), var(--card-bg-dark));
		}

		/* Explicitly tell the browser that this website supports both light and dark system settings */
		html {
			color-scheme: light dark;
		}

		body {
			background-color: var(--bg-color);
			/* The blueprint grid line color changes dynamically now */
			background-image: linear-gradient(var(--grid-color) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
			background-size: 20px 20px;
			color: var(--text-color);
			font-family: "Georgia", "Times New Roman", serif;
			line-height: 1.6;
			margin: 0;
			padding: 2rem 1rem;
		}

		.spec-container {
			max-width: 850px;
			margin: 0 auto;
			background: var(--bg-color); /* <-- Make sure this says --bg-color, not --bg-light! */
			border: 2px solid var(--blueprint-blue);
			padding: 2rem;
			box-shadow: 8px 8px 0 var(--blueprint-blue);
		}

		/* Typography */
		h1, h2, h3 {
			font-family: monospace;
			color: var(--blueprint-blue);
			margin-top: 0;
		}

		h1 {
			/* clamp(minimum_size, preferred_size, maximum_size) */
			font-size: clamp(1.2rem, 5vw, 2rem) !important;
			overflow-wrap: break-word;  /* Allows long unbroken words to snap to the next line */
			word-break: break-word;     /* Failsafe for older mobile browsers */
		}

		h2 {
			/*border-bottom: 1px dashed var(--blueprint-blue);*/
		}

		.mono { font-family: monospace; font-size: 0.9rem; }

		/* Structural Components */
		header {
			border-bottom: 1px dashed var(--blueprint-blue);
			padding-bottom: 0.1rem;
			margin-bottom: 2rem;
		}

		nav {
			font-family: monospace;
			margin: 1rem 0 0 0;
			padding: 0.5rem 0;
			border-top: 1px dashed var(--blueprint-blue);
		}

		nav a {
			margin-right: 1rem;
			text-decoration: none;
			font-weight: bold;
		}

		section {
			margin-bottom: 3.5rem;
			scroll-margin-top: 2rem; /* Smooth alignment when jumping to anchors */
		}

		fieldset {
			border: 1px solid var(--blueprint-blue);
			padding: 0.9rem 1.5rem 1.5rem 1.5rem;
			margin-bottom: 2rem;
		}

		/* This targets whatever element comes immediately after the legend
   and forces its top margin to 0, killing any hidden spacing. */
		fieldset > legend + * {
			margin-top: 0;
		}

		legend {
			font-family: monospace;
			color: var(--blueprint-blue);
			font-weight: bold;
			padding: 0 0.5rem;
		}

		/* Data Tables */
		table {
			width: 100%;
			border-collapse: collapse;
			font-family: monospace;
			margin-top: 1rem;
			display: block;        /* Forces the table to act like a standard block element */
			overflow-x: auto;      /* Creates a horizontal scrollbar ONLY inside the table */
			white-space: nowrap;   /* Stops the text inside cells from awkwardly stacking */
		}

		th, td {
			border: 1px solid var(--blueprint-blue);
			padding: 0.75rem;
			text-align: left;
		}

		th {
			background: var(--bg-color);
			color: var(--bg-light);
		}

		/* Interactive Links */
		/* Interactive Links (Ordered by LVHA rule) */
		a {
			color: var(--blueprint-blue);
			text-decoration: underline;
		}

		/* Visited link color update for readability in dark mode */
		a:visited {
			color: light-dark(#551a8b, #b085db);
		}

		a:hover {
			background: var(--blueprint-blue);
			color: #ffffff;
			text-decoration: none;
		}

		a:active {
			background: #ff5500; /* Optional: A quick flash of a different color when actually clicked */
			color: #ffffff;
		}

		/* --- Photography Matrix (Static Grid) --- */
		.photo-grid {
			display: grid;
			/* Automatically creates as many columns as will fit, minimum 300px wide */
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 1.5rem;
			margin-top: 1.5rem;
		}

		.photo-card {
			border: 1px solid var(--blueprint-blue);
			background: var(--bg-color);
			display: flex;
			flex-direction: column;
			box-shadow: 4px 4px 0 var(--blueprint-blue); /* Brutalist hardware shadow */
		}

		.photo-meta {
			padding: 0.75rem;
			font-family: monospace;
			font-size: 0.8rem;
			background: var(--card-bg); /* Uses your light/dark mode card variable */
			border-top: 1px solid var(--blueprint-blue);
			margin-top: auto;
		}

		.photo-img {
			width: 100%;
			aspect-ratio: 3 / 2;
			object-fit: cover;
			display: block;
			filter: grayscale(10%); /* Keeps that slightly raw, analog look */
		}

		/* UK CIS Departure Board System */
		.cis-board {
			background-color: #050505; /* Deep terminal black */
			border: 4px solid #1a1a1a; /* Thick, dark hardware bezel */
			padding: 1rem;
			color: #ffaa00; /* National Rail LED Amber */
			font-family: "Courier New", Courier, monospace; /* Forces strict character width */
			text-transform: uppercase;
			margin-bottom: 2rem;
			overflow: hidden;
		}

		.cis-on-time {
			color: #00ff00; /* Bright LED Terminal Green */
			text-shadow: 0 0 5px rgba(0, 255, 0, 0.4); /* Optional: Adds a tiny glow effect */
		}

		.cis-row {
			display: flex;
			justify-content: flex-start;
			font-size: clamp(0.9rem, 2vw, 1.1rem);
			font-weight: bold;
			margin-bottom: 0.25rem;
		}

		/* Rigid column widths to perfectly mimic the physical display */
		.cis-rank { width: 50px; }
		.cis-time { width: 70px; }
		.cis-plat { width: 50px; text-align: center; }
		.cis-dest { flex-grow: 1; padding-left: 1rem; }
		.cis-status { width: 90px; text-align: right; }

		.cis-scroll-row {
			display: flex;
			font-size: 0.85rem;
			margin-bottom: 1.5rem;
			padding-bottom: 1rem;
			border-bottom: 1px dotted #333; /* Faint separator line */
		}

		/* Removes the separator from the bottom train */
		.cis-board > div:last-child {
			border-bottom: none;
			margin-bottom: 0;
			padding-bottom: 0;
		}

		.cis-calling-label {
			white-space: nowrap;
			margin-right: 1rem;
			color: #cc8800; /* Slightly dimmer amber for the static label */
		}

		.cis-scroll-container {
			flex-grow: 1;
			overflow: hidden;
			position: relative;
		}

		.cis-scroll-text {
			display: inline-block;
			white-space: nowrap;
			/* Adjust the 'XXs' to make the scroll faster or slower */
			animation: cis-scroll 30s linear infinite;

			/* --- THE MEMORY LEAK FIX --- */
			will-change: transform;       /* Warns the browser an animation is happening */
			transform: translateZ(0);     /* Forces the element into a hardware-accelerated 3D layer */
			backface-visibility: hidden;  /* Prevents rendering glitches on WebKit browsers */
		}

		@keyframes cis-scroll {
			0% { transform: translate3d(100%, 0, 0); }
			100% { transform: translate3d(-100%, 0, 0); }
		}

		/* The iconic blinking "On time" indicator */
		.cis-blink {
			animation: cis-blinker 2s step-start infinite;
		}

		@keyframes cis-blinker {
			50% { opacity: 0; }
		}

		/* Mobile adjustments to prevent columns from crushing */
		@media (max-width: 600px) {
			.cis-time { width: 55px; }
			.cis-plat { width: 30px; }
			.cis-status { width: 75px; }
			.cis-dest { padding-left: 0.5rem; }
		}

		/* Mobile Optimization Constraints */
		@media (max-width: 768px) {
			body {
				padding: 1rem 0.5rem; /* Shrinks the outer margins */
			}

			.spec-container {
				padding: 1.25rem; /* Tightens the inner box padding */
				box-shadow: 4px 4px 0 var(--blueprint-blue); /* Scales down the heavy block shadow */
			}

			fieldset {
				padding: 1rem; /* Gives text a bit more breathing room on tiny screens */
			}

			nav {
				display: flex;
				flex-wrap: wrap; /* Allows links to stack cleanly instead of running off-screen */
				gap: 0.5rem;
			}

			nav a {
				margin-right: 0.5rem;
			}
		}

		/* --- Visual Exhibit: 35mm Contact Sheet --- */

		/* --- 1. The Stripped Wrapper --- */
		.contact-sheet-wrapper {
			margin-top: 1.5rem;
			margin-bottom: 2rem;
		}

		/* --- 2. The Physical Film Strip (The Scrolling Reel) --- */
		.film-strip {
			/* THE FIX: Dynamic film stock color */
			--film-base: light-dark(#111111, #333333);

			display: flex;
			justify-content: flex-start;
			gap: 1.5rem;
			padding: 2.5rem 1.5rem;

			background-color: var(--film-base);

			/* The gradient now injects our dynamic film base color */
			background-image:
				repeating-linear-gradient(90deg, var(--film-base) 0px, var(--film-base) 16px, var(--bg-color) 16px, var(--bg-color) 24px),
				repeating-linear-gradient(90deg, var(--film-base) 0px, var(--film-base) 16px, var(--bg-color) 16px, var(--bg-color) 24px);
			background-position: top 12px left 0, bottom 12px left 0;
			background-size: auto 12px;
			background-repeat: repeat-x;
			background-attachment: local;

			/* Gives the film a physical cut edge in dark mode only */
			border-top: 1px solid light-dark(transparent, #333333);
			border-bottom: 1px solid light-dark(transparent, #333333);

			/* Swipe Mechanics */
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
			-ms-overflow-style: none;

			/* Physical Drag UI */
			cursor: grab;
			user-select: none; /* Prevents accidentally highlighting text while dragging */
		}

		/* Changes cursor to a closed hand while actively clicking */
		.film-strip:active {
			cursor: grabbing;
		}

		/* Hides the system scrollbar */
		.film-strip::-webkit-scrollbar {
			display: none;
		}

		/* Hides the system scrollbar */
		.film-strip::-webkit-scrollbar {
			display: none;
		}

		/* Hides the system scrollbar */
		.film-strip::-webkit-scrollbar {
			display: none;
		}

		/* --- 3. The Individual Exposures --- */
		.film-frame {
			flex: 0 0 280px; /* Locks image width */
			display: flex;
			flex-direction: column;
			background: transparent; /* Removes old backgrounds so the film stock shows */
			scroll-snap-align: center; /* Snaps the photo to the center of the screen when swiping */
		}

		.photo-img {
			width: 100% !important;
			height: 186px !important; /* 280px width at a 3:2 ratio */
			object-fit: cover !important; /* Forces the image to fill the horizontal box without squishing */
			display: block;
			filter: grayscale(10%);

			border: none !important;
			outline: none !important;
			box-shadow: none !important;
			text-decoration: none !important;
		}

		/* --- 4. Edge Markings (Kodak/Ilford Amber Data) --- */
		.frame-meta {
			font-family: monospace;
			font-size: 0.75rem;
			color: #ffffff; /* National Rail LED Amber */
			text-align: left;
			margin-top: 0.5rem;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

	</style>
</head>
<body>

<div class="spec-container">

	<header>
		<h1 style="margin: 0;">SYSTEM_SPECIFICATION_v2.0</h1>
		<div class="mono" style="color: var(--blueprint-blue);">
			NAME: ALFIE_RALLS // HOST: LANCASTER_UNI_SCC // COORD: 54.0104° N, 2.7877° W
		</div>

		<nav>
			<a href="#manifest">// 01_MANIFEST</a>
			<a href="#status-board">// 01.5_CIS_DISPLAY</a>
			<a href="#projects">// 02_PROJECTS</a>
			<a href="#exhibit">// 03_EXHIBIT</a>
			<a href="#handshake">// 04_CONTACT</a>
		</nav>
	</header>


	<!-- SECTION 1: MANIFEST -->
	<section id="manifest">
		<h2>01_MANIFEST</h2>
		<fieldset>
			<legend>OPERATOR_MANIFEST.md</legend>
			<p style="margin: 0;">
				Hi! I'm Alfie, I'm a Computer Science student at Lancaster University, with a specific interest in software engineering and cybersecurity. I am currently gaining proficiency in Python, Java, C and C++.
			</p> <br>
			<p style="margin: 0;">
				I enjoy using and developing free open source software to the best of my ability. In return, I attempt to contribute to it through platforms such as GitHub. I also contribute to Wikipedia, primarily writing and improving articles related to the British railway network.

			</p>
		</fieldset>
		<fieldset class="mono">
			<legend>> tail -f /var/log/now</legend>
			<div style="line-height: 1.8;">
				<span style="color: var(--blueprint-blue);">[TIMESTAMP: 2026-05-19 // 22:18]</span><br>
				> <strong>[LOAD]</strong> Revising for end-of-year CS exams.<br>
				> <strong>[BUILD]</strong> Compiling this zero-JS Astro portfolio.<br>
				> <strong>[READ]</strong> <i>The Great Dune Trilogy</i> by Frank Herbert.<br>
				> <strong>[GEAR]</strong> An old Dell Optiplex system for use as a personal server.
			</div>
		</fieldset>
	</section>

	<section id="status-board">
		<h2>01.5_CIS_DISPLAY</h2>
		<div class="cis-board">
			<div class="cis-row">
				<span class="cis-rank">1st</span>
				<span class="cis-time">11:16</span>
				<span class="cis-plat">4</span>
				<span class="cis-dest">BSc Computer Science</span>
				<span class="cis-status cis-blink cis-on-time">On time</span>
			</div>
			<div class="cis-scroll-row">
				<span class="cis-calling-label">Calling at</span>
				<div class="cis-scroll-container">
					<span class="cis-scroll-text">Software Development, Fundamentals of Computer Science, Digital Systems, Professionalism in Practice, Group Projects, Internet Applications, Data Engineering, Networks and Systems, HCI: Designing for People, Sustainable Computing, Secure Data and Systems, and Applied Security Methods</span>
				</div>
			</div>

			<div class="cis-row">
				<span class="cis-rank">2nd</span>
				<span class="cis-time">06:00</span>
				<span class="cis-plat">1</span>
				<span class="cis-dest">Cairngorms Nat. Park</span>
				<span class="cis-status">Expected</span>
			</div>
			<div class="cis-scroll-row">
				<span class="cis-calling-label">Calling at</span>
				<div class="cis-scroll-container">
					<span class="cis-scroll-text">65L Backpack, OS Maps, Jetboil, Phoxx II V2, Sleeping Bag, Lantern, Hiking Poles, Food Packets, Raincoat, Walking Boots, Dry Socks, Plenty of Water, Food Packets, and Wild Camping</span>
				</div>
			</div>
		</div>
	</section>

	<!-- SECTION 2: PROJECTS -->
	<section id="projects">
		<h2>02_ENGINEERING_LOGS</h2>
		<p class="mono">Below is an indexed ledger of active code deployments and technical tools.</p>

		<table>
			<thead>
			<tr>
				<th>INDEX</th>
				<th>PROJECT_NAME</th>
				<th>ARCHITECTURE_STACK</th>
				<th>SOURCE</th>
			</tr>
			</thead>
			<tbody>
			<tr>
				<td>[01]</td>
				<td><strong>Bakewell Railway Timeline</strong></td>
				<td>WebStorm / Vite / WebGL</td>
				<td><a href="#">[DOES_NOT_EXIST]</a></td>
			</tr>
			<tr>
				<td>[02]</td>
				<td><strong>Raspberry Pi Departures Board</strong></td>
				<td>Raspberry Pi / Electronics</td>
				<td><a href="#">[DOES_NOT_EXIST]</a></td>
			</tr>
			<tr>
				<td>[03]</td>
				<td><strong>Homelab server</strong></td>
				<td>Docker / Linux</td>
				<td><a href="#">[DOES_NOT_EXIST]</a></td>
			</tr>
			<tr>
				<td>[04]</td>
				<td><strong>This website</strong></td>
				<td>Astro / HTML/ CSS</td>
				<td><a href="https://github.com/Alfie-sci/portfolio-website">[REPO]</a></td>
			</tr>
			</tbody>
		</table>
	</section>

	<!-- SECTION 3: PHOTOGRAPHY EXHIBIT -->
	<section id="exhibit">
		<h2>03_VISUAL_EXHIBIT_LOG</h2>
		<p class="mono">Analog capture extraction ledger. Geometric composition, physical architecture, and raw framing.</p>

		<div class="photo-grid">
			{contactSheetPhotos.map((photo, index) => (
				<div class="photo-card">
					<Image
						src={photo.asset}
						alt={`Photo log frame: ${photo.ref}`}
						class="photo-img"
						width={600}
						quality={90}
					loading={index < 2 ? "eager" : "lazy"}
					/>

					<div class="photo-meta">
						<strong>[{String(index + 1).padStart(2, '0')}A] {photo.ref}</strong><br />
						<span style="color: var(--blueprint-blue);">{photo.spec}</span>
					</div>
				</div>
				))}
				</div>
				</section>

	<section id="handshake">
		<h2>04_INITIATE_HANDSHAKE</h2>
		<p class="mono">Open to CS internships and infrastructure roles. Direct data transfers accepted via standard protocols.</p>

		<fieldset class="mono">
			<legend>NETWORK_ENDPOINTS.cfg</legend>
			<div style="line-height: 1.8;">
				> ENDPOINT: <a href="mailto:scroll_cosy_2v@icloud.com">scroll_cosy_2v@icloud.com</a><br>
				> GITHUB: <a href="https://github.com/Alfie-Sci">github.com/Alfie-Sci</a><br>
				> LINKEDIN: <a href="#">https://www.linkedin.com/in/alfie-ralls-7b80ab386/</a>
			</div>
		</fieldset>

		<fieldset class="mono" style="margin-bottom: 2rem;">
			<legend>EXTERNAL_NODES</legend>
			> BAKEWELL RAILWAY TIMELINE: <a href="#">UNDER_CONSTRUCTION</a><br>
		</fieldset>

	</section>

	<footer style="margin-top: 2rem; border-top: 1px solid var(--blueprint-blue); padding-top: 1rem;" class="mono">
		EOF // END OF FILE. Built with semantic HTML/CSS.
	</footer>

</div>
</body>
</html>