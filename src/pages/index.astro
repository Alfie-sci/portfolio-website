---
// index.astro Frontmatter
import { Image } from 'astro:assets';

// Import your images from src/assets/gallery/
import photo1 from '../assets/gallery/photo1.jpeg';
import photo2 from '../assets/gallery/photo2.jpeg';
import photo3 from '../assets/gallery/photo3.jpeg';
import photo4 from '../assets/gallery/photo4.jpeg';
import photo5 from '../assets/gallery/photo5.jpeg';
import photo6 from '../assets/gallery/photo6.jpeg';

// Create a highly structured data array with unique specs for each photo
const contactSheetPhotos = [
	{ ref: "ENGINEERING_ONE.JPG", spec: "26mm | ISO 400 | f/1.8", asset: photo1 },
	{ ref: "AUTO_TRAIN.JPG", spec: "26mm | ISO 400 | f/1.8", asset: photo2 },
	{ ref: "GLASSON_DOCK_9.JPG", spec: "26mm | ISO 40 | f/1.6", asset: photo3 },
	{ ref: "EVENING_STAR_92220.JPG", spec: "26mm | ISO 160 | f/1.8", asset: photo4 },
	{ ref: "TURBINE_01.JPG", spec: "26mm // ISO 50 // f/1.6", asset: photo5 },
	{ ref: "COLOUR_SIGNALS_08.JPG", spec: "26mm // ISO 100 // f/1.6", asset: photo6 },
];

// Generate a dynamic timestamp at build time
const now = new Date();
const buildDate = now.toISOString().split('T')[0];
const buildTime = now.toTimeString().split(' ')[0].slice(0, 5);
const dynamicTimestamp = `[TIMESTAMP: ${buildDate} // ${buildTime}]`;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Alfie Ralls // PORTFOLIO_v2.0</title>
	<link rel="icon" type="image/png" href="/favicon.png" />
	<link rel="apple-touch-icon" href="/favicon.png" />
	<style>
		/* Global Reset & Strict Structural Constraints */
		* { box-sizing: border-box; border-radius: 0 !important; }

		:root {
			/* Define the Light and Dark versions of your accent blue */
			--blue-light: #0033cc;
			--blue-dark:  #e0eaf5;

			/* Let the system choose which one to use */
			--blueprint-blue: light-dark(var(--blue-light), var(--blue-dark));

			/* LIGHT MODE PALETTE */
			--bg-light: #ffffff;
			--text-light: #111111;
			--grid-light: #e0e6ed;
			--card-bg-light: #ffffff;

			/* DARK MODE PALETTE (Classic Cyanotype) */
			--bg-dark: #0a1428;       /* Deep architectural navy */
			--text-dark: #e0eaf5;     /* Soft ice-blue white for contrast without glare */
			--grid-dark: #1c2e4a;     /* Pronounced dark cyan-blue for gridlines */
			--card-bg-dark: #112240;  /* Slightly elevated navy for floating panels */

			/* The System Switchers */
			--bg-color: light-dark(var(--bg-light), var(--bg-dark));
			--text-color: light-dark(var(--text-light), var(--text-dark));
			--grid-color: light-dark(var(--grid-light), var(--grid-dark));
			--card-bg: light-dark(var(--card-bg-light), var(--card-bg-dark));
		}

		/* Explicitly tell the browser that this website supports both modes */
		html {
			color-scheme: light dark;
		}

		body {
			background-color: var(--bg-color);
			background-image: linear-gradient(var(--grid-color) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
			background-size: 20px 20px;
			color: var(--text-color);
			font-family: "Georgia", "Times New Roman", serif;
			line-height: 1.6;
			margin: 0;
			padding: 2rem 1rem;
		}

		.spec-container {
			max-width: 850px;
			margin: 0 auto;
			background: var(--bg-color);
			border: 2px solid var(--blueprint-blue);
			padding: 2rem;
			box-shadow: 8px 8px 0 var(--blueprint-blue);
			position: relative; /* Added for crosshairs */
		}

		/* --- Fiduciary Crosshairs --- */
		.crosshair {
			position: absolute;
			width: 20px;
			height: 20px;
			pointer-events: none;
			z-index: 50;
		}
		.crosshair::before, .crosshair::after {
			content: "";
			position: absolute;
			background: var(--blueprint-blue);
		}
		.crosshair::before { top: 9px; left: 0; width: 20px; height: 1px; }
		.crosshair::after { top: 0; left: 9px; width: 1px; height: 20px; }

		.ch-tl { top: 10px; left: 10px; }
		.ch-tr { top: 10px; right: 10px; }
		.ch-bl { bottom: 10px; left: 10px; }
		.ch-br { bottom: 10px; right: 10px; }

		/* --- Typography --- */
		h1, h2, h3 {
			font-family: monospace;
			color: var(--blueprint-blue);
			margin-top: 0;
		}

		h1 {
			font-size: clamp(1.2rem, 5vw, 2rem) !important;
			overflow-wrap: break-word;
			word-break: break-word;
		}

		.mono {
			font-family: monospace;
			font-size: 0.9rem;
		}

		/* --- Structural Components --- */
		header {
			border-bottom: 1px dashed var(--blueprint-blue);
			padding-bottom: 0.1rem;
			margin-bottom: 2rem;
		}

		nav {
			font-family: monospace;
			margin: 1rem 0 0 0;
			padding: 0.5rem 0;
			border-top: 1px dashed var(--blueprint-blue);
		}

		nav a {
			margin-right: 1rem;
			text-decoration: none;
			font-weight: bold;
		}

		section {
			margin-bottom: 3.5rem;
			scroll-margin-top: 2rem;
		}

		fieldset {
			border: 1px solid var(--blueprint-blue);
			padding: 0.9rem 1.5rem 1.5rem 1.5rem;
			margin-bottom: 2rem;
		}

		fieldset > legend + * {
			margin-top: 0;
		}

		legend {
			font-family: monospace;
			color: var(--blueprint-blue);
			font-weight: bold;
			padding: 0 0.5rem;
		}

		/* --- Interactive Links --- */
		a {
			color: var(--blueprint-blue);
			text-decoration: underline;
		}

		a:visited {
			color: light-dark(#551a8b, #b085db);
		}

		a:hover {
			background: var(--blueprint-blue);
			color: #ffffff;
			text-decoration: none;
		}

		a:active {
			background: #ff5500;
			color: #ffffff;
		}

		/* --- SECTION: Geolocation Radar (Hardware Casing) --- */
		:root {
			--radar-green: #00cd00;
		}

		.coord-trigger {
			position: relative;
			display: inline-block;
			padding: 0 4px;
			cursor: crosshair;
			transition: background 0.2s ease-out, color 0.2s ease-out;
		}

		.coord-trigger::before {
			content: "";
			position: absolute;
			top: 30px;
			left: 50%;
			width: 200px;
			height: 200px;
			background-color: #050505;
			border: 3px solid #1a1a1a;
			box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.8);
			border-radius: 8px;
			background-image:
				linear-gradient(rgba(0, 255, 65, 0.15) 1px, transparent 1px),
				linear-gradient(90deg, rgba(0, 255, 65, 0.15) 1px, transparent 1px);
			background-size: 20px 20px;
			background-position: center;
			transform: translateX(-50%) scale(0.95);
			transform-origin: top center;
			opacity: 0;
			pointer-events: none;
			z-index: 90;
			transition: opacity 0.2s ease-out, transform 0.2s ease-out;
		}

		.coord-trigger::after {
			content: "";
			position: absolute;
			top: 40px;
			left: 50%;
			width: 180px;
			height: 180px;
			border-radius: 50%;
			border: 1px solid rgba(0, 255, 65, 0.3);
			background-image: conic-gradient(
				from 0deg at 50% 50%,
				transparent 0deg,
				rgba(0, 255, 65, 0.1) 60deg,
				rgba(0, 255, 65, 0.8) 90deg,
				transparent 90deg
			);
			transform-origin: 50% 50%;
			transform: translateX(-50%) rotate(0deg);
			opacity: 0;
			pointer-events: none;
			z-index: 100;
			transition: opacity 0.2s ease-out;
		}

		.blip {
			position: absolute;
			width: 6px;
			height: 6px;
			background-color: var(--radar-green);
			border-radius: 50%;
			box-shadow: 0 0 8px var(--radar-green);
			opacity: 0;
			pointer-events: none;
			z-index: 110;
		}

		.blip-1 { top: 100px; left: calc(50% + 52px); }
		.blip-2 { top: 195px; left: calc(50% + 24px); }
		.blip-3 { top: 122px; left: calc(50% - 49px); }

		.coord-trigger:hover {
			background-color: light-dark(rgba(0, 51, 204, 0.05), rgba(51, 102, 255, 0.15));
		}

		.coord-trigger:active {
			background-color: rgba(0, 255, 65, 0.15);
			color: var(--radar-green);
		}

		.coord-trigger:active::before {
			opacity: 1;
			transform: translateX(-50%) scale(1);
		}

		.coord-trigger:active::after {
			opacity: 1;
			animation: tactical-radar-sweep 1.5s linear infinite;
		}

		.coord-trigger:active .blip {
			animation: blip-flash 1.5s infinite;
		}

		.coord-trigger:active .blip-1 { animation-delay: 1.37s; }
		.coord-trigger:active .blip-2 { animation-delay: 0.29s; }
		.coord-trigger:active .blip-3 { animation-delay: 0.79s; }

		@keyframes tactical-radar-sweep {
			to { transform: translateX(-50%) rotate(360deg); }
		}

		@keyframes blip-flash {
			0%, 100% { opacity: 0; transform: scale(0.5); }
			1%  { opacity: 1; transform: scale(1.5); }
			25% { opacity: 0.4; transform: scale(1); }
			50% { opacity: 0; }
		}

		/* --- Photography Matrix (Polaroids) --- */
		.photo-grid-wrapper {
			position: relative;
			padding: 1.5rem;
			border: 1px dashed light-dark(rgba(0, 51, 204, 0.3), rgba(51, 102, 255, 0.3));
			margin-top: 2rem;
		}

		/* Crop Marks */
		.crop-mark {
			position: absolute;
			width: 15px;
			height: 15px;
			border-color: var(--blueprint-blue);
			border-style: solid;
			border-width: 0;
		}
		.cm-tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
		.cm-tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
		.cm-bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
		.cm-br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

		.photo-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 1.5rem;
		}

		.photo-card {
			background: var(--bg-color);
			border: 1px solid var(--blueprint-blue);
			padding: 0.75rem 0.75rem 0 0.75rem;
			display: flex;
			flex-direction: column;
			box-shadow: 4px 4px 0 var(--blueprint-blue);
			transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
			position: relative;

			/* FIX: Prevents WebKit borders from flashing/jumping during transform */
			backface-visibility: hidden;
			-webkit-backface-visibility: hidden;
			transform: translateZ(0);
			-webkit-transform: translateZ(0);
			will-change: transform, box-shadow;
		}

		.photo-card::before {
			content: "";
			position: absolute;
			top: -12px;
			left: -16px;
			width: 45px;
			height: 25px;
			transform: rotate(-35deg);
			background-color: light-dark(rgba(0, 0, 0, 0.08), rgba(255, 255, 255, 0.2));
			backdrop-filter: blur(4px);
			border: 1px solid light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.1));
			z-index: 20;
			transition: transform 0.2s ease-out;
		}

		.photo-card:hover::before {
			transform: translateY(2px) rotate(-32deg) scaleX(1.05);
		}

		.photo-card::after {
			content: "";
			position: absolute;
			/* FIX: Inset the gradient so it never overlaps or spills onto the actual border */
			top: 1px;
			left: 1px;
			width: calc(100% - 2px);
			height: calc(100% - 2px);
			background: linear-gradient(
				105deg,
				transparent 35%,
				rgba(255, 255, 255, 0.3) 50%,
				transparent 65%
			);
			background-size: 300% 100%;
			background-position: 100% 0;
			z-index: 5;
			pointer-events: none;
			transition: background-position 0.2s ease-in;
		}

		.photo-card:hover::after {
			background-position: 0 0;
			transition: background-position 0.2s ease-out;
		}

		.photo-card:hover {
			/* Added translateZ(0) to maintain hardware acceleration during hover */
			transform: translateY(-5px) rotate(-0.5deg) translateZ(0);
			box-shadow: 10px 10px 0 var(--blueprint-blue);
			z-index: 10;
		}

		.photo-img {
			width: 100% !important;
			height: auto !important;
			aspect-ratio: 1 / 1 !important;
			object-fit: cover !important;
			display: block;
			filter: grayscale(10%) contrast(110%);
		}

		.photo-meta {
			padding: 1rem 0.25rem 0.75rem 0.25rem;
			font-family: monospace;
			font-size: 0.75rem;
			text-align: center;
			background: transparent;
			border-top: none;
			margin-top: auto;
			position: relative;
			z-index: 10;
		}

		/* --- Title Block Footer --- */
		.title-block {
			display: grid;
			grid-template-columns: 2fr 2fr 1fr 2fr 1fr;
			border: 2px solid var(--blueprint-blue);
			margin-top: 4rem;
			font-size: 0.85rem;
		}
		.tb-section {
			padding: 0.75rem;
			border-right: 2px solid var(--blueprint-blue);
		}
		.tb-section:last-child { border-right: none; }

		/* --- SECTION: Terminal-Grade Accessibility (a11y) --- */
		*:focus {
			outline: none;
		}

		:focus-visible {
			outline: 2px dashed var(--blueprint-blue) !important;
			outline-offset: 4px !important;
			background-color: light-dark(rgba(0, 51, 204, 0.1), rgba(51, 102, 255, 0.15)) !important;
			border-radius: 0 !important;
		}

		.photo-card:focus-visible {
			box-shadow: 8px 8px 0 var(--blueprint-blue);
			transform: translateY(-2px);
		}
		/* --- Interactive Hex Inspector (Polished & Dynamic) --- */
		.hex-dump {
			background: var(--card-bg);
			border: 1px solid var(--blueprint-blue);
			padding: 0; /* Reduced padding slightly for better edge alignment */
			font-size: 0.85rem;
			overflow-x: hidden; /* Prevent global scrollbar; individual summaries handle overflow if needed */
=		}

		.hex-row {
			display: block;
			margin-bottom: 0; /* REMOVED: No more gap between elements */
			border-bottom: 1px dashed light-dark(rgba(0, 51, 204, 0.15), rgba(51, 102, 255, 0.15));

			/* ADDED: Slightly increased top/bottom padding to preserve that spacious, comfortable layout */
			padding: 0.75rem 0.5rem;

			transition: background 0.2s ease, border-left 0.2s ease;
			border-left: 3px solid transparent;
		}

		/* Hover highlights the entire unified block, active or collapsed */
		.hex-row:hover {
			background: light-dark(rgba(0, 51, 204, 0.04), rgba(51, 102, 255, 0.08));
		}

		/* When expanded, lock the card in with a solid blueprint border accent */
		details[open] {
			background: light-dark(rgba(0, 51, 204, 0.02), rgba(255, 255, 255, 0.02));
			border-left: 3px solid var(--blueprint-blue);
			border-bottom: 1px dashed var(--blueprint-blue);
		}

		.hex-summary {
			display: flex;
			align-items: center;
			cursor: pointer;
			list-style: none;
			user-select: none;
			width: 100%;
		}

		.hex-summary::-webkit-details-marker {
			display: none;
		}

		/* The summary bytes should remain single-line, but handle overflow on narrow displays */
		.hex-bytes {
			color: light-dark(#888, #666);
			flex-grow: 1;
			letter-spacing: 2px;
			margin: 0 1rem;
			font-family: "Courier New", Courier, monospace;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		/* Interactive [+] indicator */
		.hex-summary::after {
			content: " [+]";
			color: var(--blueprint-blue);
			font-weight: bold;
			margin-left: auto;
			font-family: monospace;
			white-space: nowrap;
		}
		details[open] .hex-summary::after {
			content: " [-]";
		}

		/* The Inspect Panel - FIXED wrapping so text never goes offscreen */
		.project-details {
			margin: 0.75rem 0 0.25rem 0.5rem;
			padding: 0.75rem;
			border-top: 1px dashed light-dark(rgba(0, 51, 204, 0.15), rgba(51, 102, 255, 0.15));
			font-size: 0.8rem;
			line-height: 1.5;

			/* THE WRAP FIX: Force normal wrap, breaking variables only if they are extremely long */
			white-space: normal;
			word-wrap: break-word;
			word-break: break-word;
		}

		.project-details strong {
			color: var(--blueprint-blue);
		}

		.hex-row:last-child { border-bottom: none;}
		.hex-row:hover { background: light-dark(rgba(0, 51, 204, 0.05), rgba(51, 102, 255, 0.15)); }
		.hex-addr { color: var(--blueprint-blue); width: 65px; opacity: 0.8; }
		.hex-bytes { color: light-dark(#888, #666); flex-grow: 1; letter-spacing: 2px; margin: 0 1rem; font-family: "Courier New", Courier, monospace;}
		.hex-ascii { width: 140px; }
		.hex-status { width: 90px; text-align: right; }
		.status-offline { color: light-dark(#888, #666); }
		.status-active { color: var(--radar-green); font-weight: bold; }

		/* --- SECTION: The Print Stylesheet --- */
		@media print {
			body {
				background-color: #ffffff !important;
				color: #000000 !important;
				background-image: linear-gradient(#eaeaea 1px, transparent 1px),
				linear-gradient(90deg, #eaeaea 1px, transparent 1px) !important;
			}
			.spec-container {
				border: 1px solid #000000 !important;
				box-shadow: none !important;
				padding: 0 !important;
				max-width: 100% !important;
			}
			h1, h2, h3, a, legend {
				color: #000000 !important;
				text-decoration: none !important;
			}
			.coord-trigger::before,
			.coord-trigger::after,
			.photo-card::before,
			.photo-card::after {
				display: none !important;
			}
			.photo-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr) !important;
				gap: 1rem !important;
			}
			.photo-card {
				break-inside: avoid;
				page-break-inside: avoid;
				border: 1px solid #000000 !important;
				box-shadow: none !important;
				transform: none !important;
			}
			.photo-img {
				filter: grayscale(100%) contrast(120%) !important;
			}
			.cis-board {
				background-color: #ffffff !important;
				border: 2px solid #000000 !important;
				color: #000000 !important;
			}
			.cis-on-time {
				color: #000000 !important;
				text-shadow: none !important;
			}
			.cis-scroll-text {
				animation: none !important;
				transform: none !important;
				white-space: normal !important;
			}
			.title-block { border: 1px solid #000000 !important; }
			.tb-section { border-right: 1px solid #000000 !important; }
		}

		/* --- UK CIS Departure Board System --- */
		.cis-board {
			background-color: #050505;
			border: 4px solid #1a1a1a;
			padding: 1rem;
			color: #ffaa00;
			font-family: "Courier New", Courier, monospace;
			text-transform: uppercase;
			margin-bottom: 2rem;
			overflow: hidden;
		}
		.cis-on-time {
			color: #00ff00;
			text-shadow: 0 0 5px rgba(0, 255, 0, 0.4);
		}
		.cis-row {
			display: flex;
			justify-content: flex-start;
			font-size: clamp(0.9rem, 2vw, 1.1rem);
			font-weight: bold;
			margin-bottom: 0.25rem;
		}
		.cis-rank { width: 50px; }
		.cis-time { width: 70px; }
		.cis-plat { width: 50px; text-align: center; }
		.cis-dest { flex-grow: 1; padding-left: 1rem; }
		.cis-status { width: 90px; text-align: right; }
		.cis-scroll-row {
			display: flex;
			font-size: 0.85rem;
			margin-bottom: 1.5rem;
			padding-bottom: 1rem;
			border-bottom: 1px dotted #333;
		}
		.cis-board > div:last-child {
			border-bottom: none;
			margin-bottom: 0;
			padding-bottom: 0;
		}
		.cis-calling-label {
			white-space: nowrap;
			margin-right: 1rem;
			color: #cc8800;
		}
		.cis-scroll-container {
			flex-grow: 1;
			overflow: hidden;
			position: relative;
		}
		.cis-scroll-text {
			display: inline-block;
			white-space: nowrap;
			animation: cis-scroll 30s linear infinite;
			will-change: transform;
			transform: translateZ(0);
			backface-visibility: hidden;
		}
		@keyframes cis-scroll {
			0% { transform: translate3d(100%, 0, 0); }
			100% { transform: translate3d(-100%, 0, 0); }
		}
		.cis-blink {
			animation: cis-blinker 2s step-start infinite;
		}
		@keyframes cis-blinker {
			50% { opacity: 0; }
		}

		/* --- Media Queries (Mobile Optimization) --- */
		@media (max-width: 768px) {
			body {
				padding: 1rem 0.5rem;
			}
			.spec-container {
				padding: 1.25rem;
				box-shadow: 4px 4px 0 var(--blueprint-blue);
			}
			fieldset {
				padding: 1rem;
			}
			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			nav a {
				margin-right: 0.5rem;
			}
			.title-block { grid-template-columns: 1fr; }
			.tb-section { border-right: none; border-bottom: 2px solid var(--blueprint-blue); }
			.tb-section:last-child { border-bottom: none; }
		}

		@media (max-width: 600px) {
			.cis-time { width: 55px; }
			.cis-plat { width: 30px; }
			.cis-status { width: 75px; }
			.cis-dest { padding-left: 0.5rem; }
			.hex-bytes { display: none; }
		}
	</style>
</head>
<body>

<div class="spec-container">

	<!-- Registration Crosshairs -->
	<div class="crosshair ch-tl"></div>
	<div class="crosshair ch-tr"></div>
	<div class="crosshair ch-bl"></div>
	<div class="crosshair ch-br"></div>

	<header>
		<h1 style="margin: 0;">SYSTEM_SPECIFICATION_v2.0</h1>
		<div class="mono" style="color: var(--blueprint-blue);">
			NAME: ALFIE_RALLS // HOST: LANCASTER_UNI_SCC //
			<span class="coord-trigger" title="POWER_USER: Click and hold to activate radar scan">
			COORD: 54.0104° N, 2.7877° W
				<span class="blip blip-1"></span>
				<span class="blip blip-2"></span>
				<span class="blip blip-3"></span>
			</span>
		</div>

		<nav>
			<a href="#manifest">// 01_MANIFEST</a>
			<a href="#status-board">// 01.5_CIS_DISPLAY</a>
			<a href="#projects">// 02_PROJECTS</a>
			<a href="#exhibit">// 03_EXHIBIT</a>
			<a href="#handshake">// 04_CONTACT</a>
